# Copier vers .env et ajuster si besoin. Aucune valeur ci-dessous n'est un secret réel.

# Base vectorielle. NON UTILISE depuis D45 : Chroma tourne EMBARQUE, en
# processus, sans service ni conteneur. La variable reste pour memoire, au cas ou
# l'on reviendrait a un service. L'index vit sous SORABEL_DATA_DIR/index.
# CHROMA_URL=http://localhost:8002

# Modèle d'embeddings (sentence-transformers via l'extra [vector]),
# ex. intfloat/multilingual-e5-small
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Base SQL Sorabel (SQLite, générée par `make seed`)
SORABEL_DB=data/sorabel.db

# Reranking documentaire, cross-encoder. Le defaut est un modele multilingue
# leger : mesure, l'hybride plafonne deja sur le classement, et le reranker
# n'apporte que sur la DECISION D'ABSTENTION. Repli possible sur
# BAAI/bge-reranker-v2-m3, quatre fois plus lourd.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Generation SQL. RETENU (D48) : petit modele local via transformers, mesure a
# 17/24 sur eval/questions_sql.jsonl, 12 a 20 s en regime. Rien ne quitte le
# poste. Echelon suivant si la qualite doit monter : Azure AI Foundry, dans le
# locataire du client, PAS un cloud tiers.
SQL_MODEL=Qwen/Qwen2.5-Coder-0.5B-Instruct

# Variante Ollama, mesuree et NON retenue : sur un processeur bride a 801 MHz,
# le 7B produit 0,38 jeton par seconde et sa latence n'est pas previsible.
# Le module sql/generateur_ollama.py reste disponible.
# SQL_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434

# Chemin UNIQUE de tout artefact persistant (D35). Le stockage d'un conteneur
# est ephemere par defaut : un index ecrit ailleurs disparait au redemarrage
# SANS erreur. Vertu secondaire, en local : le chemin est explicite.
SORABEL_DATA_DIR=data

# Journal des appels de la gateway
GATEWAY_JOURNAL=logs/journal.jsonl

# Profil client par défaut du serveur MCP (support | commercial)
SORABEL_PROFILE=support
